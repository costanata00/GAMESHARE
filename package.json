{
  "name": "gameshare",
  "productName": "GameShare",
  "version": "1.7.0",
  "description": "Voice chat and game screen sharing for up to 10 players. Peer-to-peer, no server to run.",
  "main": "boot.js",
  "author": "GameShare",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "build:audio": "x86_64-w64-mingw32-g++ -O2 -static -municode -o bin/win32-x64/GameShareAudio.exe native/app-audio.cpp -lole32",
    "update:keygen": "node scripts/update-keygen.js",
    "update:pack": "node scripts/update-pack.js"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "@electron/asar": "^3.4.1"
  },
  "build": {
    "appId": "app.gameshare.desktop",
    "productName": "GameShare",
    "files": [
      "boot.js",
      "main.js",
      "updater.js",
      "preload.js",
      "index.html",
      "i18n.js",
      "renderer.js",
      "styles.css",
      "node_modules/peerjs/dist/peerjs.min.js",
      "app-audio-worklet.js",
      "bin/win32-x64/GameShareAudio.exe",
      "build/icon.png",
      "fonts/archivo.woff2",
      "fonts/OFL.txt",
      "noise-worklet.js",
      "vendor/rnnoise-sync.js",
      "vendor/rnnoise-LICENSE.txt",
      "overlay.html",
      "overlay.js",
      "overlay-preload.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "GameShare uses your microphone for voice chat with your friends.",
        "NSCameraUsageDescription": "GameShare does not use your camera."
      },
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "bin/**"
    ]
  }
}
